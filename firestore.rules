rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    // Loan Validation helper
    function isValidLoan(data) {
      return data.id is string && data.id.size() <= 128
        && data.serialNumber is number
        && data.date is string && data.date.size() <= 50
        && data.name is string && data.name.size() <= 200
        && data.contactNumber is string && data.contactNumber.size() <= 30
        && data.metalType is string && (data.metalType == 'Gold' || data.metalType == 'Silver' || data.metalType == 'Both')
        && data.amount is number
        && data.interestRate is number
        && data.status is string && (data.status == 'Active' || data.status == 'Closed');
    }

    // Connection test route
    match /test/connection {
      allow get: if true;
    }

    // Direct Device-to-Device cloud pairing synchronization channel
    match /pairings/{pairingId} {
      allow read, write: if pairingId is string && pairingId.matches('^[0-9]{6}$');
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /loans/{loanId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(loanId) && isValidLoan(request.resource.data);
        allow update: if isOwner(userId) && isValidId(loanId) && isValidLoan(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /backups/{backupId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(backupId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
